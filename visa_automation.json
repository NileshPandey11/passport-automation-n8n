      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || item;\n\n// WhatsApp sender ka number aur naam\nconst from = body.From || body.from || \"\";\nconst phone = from.replace(\"whatsapp:\", \"\");\nconst name = body.ProfileName || body.name || \"\";\nconst text = (body.Body || body.text || \"\").trim();\n\n// 1. Agar Twilio se seedha media aaye (production number), to wahi use karo\nlet mediaUrl = body.MediaUrl0 || \"\";\n\n// 2. Warna message text mein se Google Drive link nikaalo\nif (!mediaUrl) {\n  const driveMatch = text.match(/https?:\\/\\/drive\\.google\\.com\\/[^\\s]+/);\n  if (driveMatch) {\n    const link = driveMatch[0];\n    const idMatch =\n      link.match(/\\/d\\/([a-zA-Z0-9_-]+)/) ||\n      link.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n    if (idMatch) {\n      mediaUrl = `https://drive.google.com/uc?export=download&id=${idMatch[1]}`;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    user_phone: phone,\n    user_name: name,\n    text: text,\n    media_url: mediaUrl\n  }\n}];"
      },
